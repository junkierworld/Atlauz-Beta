# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# Get these from your Supabase project settings (https://supabase.com)
# Project → Settings → API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# APPLICATION VERSION & METADATA
# VITE_APP_VERSION: Semantic version (e.g., 1.0.0, 1.1.0, 2.0.0)
# VITE_APP_NAME: Application display name
# VITE_IS_PRODUCTION: Set to "true" for production builds, "false" for development
VITE_APP_VERSION="1.0.0"
VITE_APP_NAME="Atlauz"
VITE_IS_PRODUCTION="false"
